<Defs>

  <RecipeDef>
    <defName>RimRoof_CutStoneRoofTiles</defName>
    <label>cut stone roof tiles</label>
    <description>Cut stone into roof tiles.</description>
    <jobString>cutting stone roof tiles</jobString>
    <workAmount>900</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>StoneChunks</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>StoneChunks</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <RimRoof_StoneRoofTile>3</RimRoof_StoneRoofTile>
    </products>
    <recipeUsers>
      <li>TableStonecutter</li>
    </recipeUsers>
    <researchPrerequisite>Stonecutting</researchPrerequisite>
  </RecipeDef>

