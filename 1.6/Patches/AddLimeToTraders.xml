<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/TraderKindDef[defName="Orbital_GeneralSupply"]/stockGenerators</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TraderKindDef[defName="Orbital_GeneralSupply"]/stockGenerators</xpath>
      <value>
        <li Class="StockGenerator_SingleDef">
          <thingDef>RimRoof_Lime</thingDef>
          <countRange>
            <min>2</min>
            <max>10</max>
          </countRange>
          <totalPriceRange>
            <min>20</min>
            <max>100</max>
          </totalPriceRange>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/TraderKindDef[defName="Caravan_Outlander_ItemTrader"]/stockGenerators</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TraderKindDef[defName="Caravan_Outlander_ItemTrader"]/stockGenerators</xpath>
      <value>
        <li Class="StockGenerator_SingleDef">
          <thingDef>RimRoof_Lime</thingDef>
          <countRange>
            <min>1</min>
            <max>5</max>
          </countRange>
          <totalPriceRange>
            <min>10</min>
            <max>50</max>
          </totalPriceRange>
        </li>
      </value>
    </match>
  </Operation>

</Patch>
